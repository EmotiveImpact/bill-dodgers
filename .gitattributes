* text=auto

# Keep generated-source hashes and cross-platform scripts deterministic.
*.gd text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.html text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.py text eol=lf

# Native packed resources and artwork must retain their original bytes.
*.res binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.ogg binary
*.mp3 binary
*.wav binary

# Preserve captured test evidence verbatim, including tool-output spacing.
docs/validation/** -whitespace
