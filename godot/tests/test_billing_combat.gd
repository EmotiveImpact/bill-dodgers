extends SceneTree
const Host = preload("res://tests/test_world_six_support.gd")
var checks := 0
var failures := 0
func check(ok: bool,label: String) -> void:
	checks+=1
	if not ok: failures+=1;printerr("FAIL: "+label)
func near(a: float,b: float,label: String) -> void: check(absf(a-b)<0.001,label)
func shot(p: Vector2, damage: int = 1) -> Dictionary: return {"p":p,"v":Vector2.ZERO,"enemy":false,"life":20.0,"damage":damage}
func _initialize()->void:call_deferred("run")
func run()->void:
	var h:=Host.new()
	h.load_stage("6-1")
	var c=h.combat
	var w=h.world_six
	c.reset(h,2)
	check(c.waves[0].group.size()==4,"multiplayer appends x group")
	check(c.waves[0].group[3][0]==1650,"source append order retained")
	c.reset(h,1)
	check(c.waves[0].group.size()==3,"solo excludes extras")
	h.camera.x=498;c.waves_tick(0,h)
	check(c.waves[0].started and c.waves[0].index==1 and h.enemies.size()==1,"first wave spawn same frame threshold")
	near(h.camera_lock,538,"locked wave camera plus40")
	h.enemies.clear();c.spawn_flier(h,"r");c.waves[0].index=3;c.waves_tick(0,h)
	check(not c.waves[0].done,"fliers hold camera wave open")
	w.fliers[0].state="pop";c.waves_tick(0,h)
	check(c.waves[0].done and h.camera_lock==null,"popped mailer releases wave")
	h.load_stage("6-4");h.player.y=-18;c.waves_tick(0,h)
	check(c.waves[0].started and h.camera_lock==null,"height free wave no lock")
	c.waves_tick(0.7,h)
	check(c.waves[0].done,"free wave complete with enemies alive")
	h.load_stage("6-1");h.coins.clear();c.spawn_flier(h,"r")
	var f: Dictionary=w.fliers[0]
	check(f.hp==2 and absf(f.p.x-h.view_width()-60)<0.001,"mailer exact health/offscreen spawn")
	f.p=Vector2(400,250);f.entered=true;f.off=0;f.cd=0;h.player=Vector2(400,482)
	c.fliers_tick(0,h)
	check(h.bullets.size()==1 and h.bullets[0].get("leaf",false),"mailer leaflet")
	near(h.bullets[0].gravity,1100,"leaflet gravity")
	var edge:=shot(f.p+Vector2(38,0))
	check(not c.intercept_shot(h,edge),"mailer strict horizontal hit extent")
	var center:=shot(f.p,2)
	check(c.intercept_shot(h,center) and f.state=="pop" and h.coins.size()==3 and h.pop_count==1,"mailer damage/reward")
	c.fliers_tick(0.7,h);check(w.fliers.size()==1,"pop retained at exact .7 seconds")
	c.fliers_tick(0.001,h);check(w.fliers.is_empty(),"pop removed after .7 seconds")
	h.load_stage("6-3");h.camera.x=500;c.spawn_drop(h,"throw")
	check(h.enemies.size()==1 and h.enemies[0].has("hop"),"vent drop creates hop")
	var drop: Dictionary=h.enemies[0]
	near(drop.hop.duration,0.52,"vent drop duration")
	near(drop.hop.start.y,h.view_top()-40,"drop starts above viewport")
	check(w.vents.size()==1,"vent warning")
	c.enemies_tick(0.52,h)
	check(not drop.has("hop") and drop.p.y==drop.surface.row[2],"drop lands live geometry")
	h.load_stage("6-1");h.camera.x=6900;c.start_mini(h,"franker",c.waves[5])
	var m: Dictionary=w.mini_boss
	check(m.hp==44 and m.state=="enter" and m.x-m.x1==400,"franker health/entry")
	c.mini_tick(1.6,h)
	check(m.state=="fight" and m.x==m.x1,"franker enters 250 px/s")
	m.cd=0;c.mini_tick(0,h)
	check(h.bullets.filter(func(b):return b.get("stamp",false)).size()==3,"franker first stamp volley")
	m.cd=0;c.mini_tick(0,h);m.cd=0;c.mini_tick(0,h)
	check(m.shock.size()==1 and m.shock[0].vx==-400,"franker third attack slam")
	m.hp=26.4;m.calls=0;c.mini_tick(0,h)
	check(m.calls==0,"mini 60 percent strict boundary")
	m.hp=26.39;c.mini_tick(0,h)
	check(m.calls==1 and not w.fliers.is_empty(),"mini 60 percent backup")
	m.hp=13.2;c.mini_tick(0,h);check(m.calls==1,"mini 30 percent strict boundary")
	m.hp=13.19;c.mini_tick(0,h);check(m.calls==2,"mini second backup")
	var hits:=h.pop_count
	c.intercept_shot(h,shot(Vector2(m.x,m.y-100),100))
	check(m.state=="down" and m.shock.is_empty() and h.pop_count==hits+5,"mini death clears shock and credits five")
	check(h.bullets.filter(func(b):return b.get("stamp",false)).all(func(b):return b.dead),"mini death invalidates stamps")
	h.load_stage("6-3");c.start_mini(h,"jammer");m=w.mini_boss;m.state="fight";m.x=m.x1
	m.n=0;m.cd=0;c.mini_tick(0,h)
	near(h.bullets.back().p.y,m.y-132,"jammer odd high sheet")
	m.cd=0;c.mini_tick(0,h)
	near(h.bullets.back().p.y,m.y-34,"jammer even low sheet")
	m.n=3;m.cd=0;c.mini_tick(0,h)
	var delayed: Dictionary=h.bullets.back()
	check(delayed.sheet and delayed.delay==0.38,"jammer fourth delayed sheet")
	var px: float=delayed.p.x
	w.world_tick(0.1,h);c.projectiles_tick(0.1,h)
	near(delayed.p.x,px,"delayed sheet world counter-motion before projectile step")
	h.load_stage("6-1");h.coins.clear();h.player=Vector2(400,482)
	var surface: Dictionary=w.below(h,400,482)
	var debit: Dictionary=c.new_bot(h,400,surface,"rush",{"entered":true,"type":"debit","kind":"debit","hp":2,"speed":170.0})
	h.score=4;c.debits_tick(0,h)
	check(debit.latch,"debit latches without damage")
	c.debits_tick(0.65,h);check(h.score==4,"debit drain strict .65")
	c.debits_tick(0.001,h);check(h.score==3,"debit drains pound")
	h.grounded=false;c.debits_tick(0,h);check(debit.jumps==1,"first airborne edge")
	c.debits_tick(0,h);check(debit.jumps==1,"airtime does not retrigger jump")
	h.grounded=true;c.debits_tick(0,h);h.grounded=false;c.debits_tick(0,h)
	check(not debit.latch and debit.has("hop") and debit.cool==1.5,"two jumps shake off with cooldown")
	h.load_stage("6-1");h.camera.x=1400;h.player=Vector2(1600,420);var bot: Dictionary=c.new_bot(h,1600,w.surfaces(h)[0],"rush",{"entered":true})
	c.bot_navigation(h)
	check(bot.has("hop") and bot.hop.surface.art=="belt","inside solid robot climbs belt")
	c.enemies_tick(0.42,h)
	near(bot.p.y,420,"robot belt landing")
	h.player=Vector2(1650,200);bot.p=Vector2(1700,420);bot.state="walk";bot.entered=true
	for i in range(94):c.bot_navigation(h)
	check(bot.type=="throw" and bot.speed==75,"unreachable player turns rusher into thrower after source frame count")
	h.load_stage("6-1");h.coins.clear();h.player=Vector2(300,482)
	var stay: Dictionary={"p":Vector2(600,382),"v":Vector2.ZERO,"age":99.0,"rest":true,"stay":true}
	h.coins.append(stay);c.pickups_tick(0,h)
	check(h.coins.has(stay),"stay coins do not expire")
	h.camera.x=660;c.pickups_tick(0,h)
	check(not h.coins.has(stay),"stay coins culled exactly at camera minus60")
	h.load_stage("6-1");h.player=Vector2(400,482);h.enemies.clear();h.bullets.clear()
	c.bill(h,Vector2(400,400),Vector2.ZERO,0,{"dead":true})
	c.projectiles_tick(0.01,h)
	check(h.hearts==3 and h.bullets.is_empty(),"canceled bills do not hit player")
	print("Billing combat: %d checks, %d failures"%[checks,failures])
	quit(0 if failures==0 else 1)
